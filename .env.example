# Digmark V3.1 — required environment variables (server-side only; never committed).
# Copy to `.env.local` and fill real values. `.env*` is gitignored.

# --- Google Sheets service account (least privilege: spreadsheets scope) ---
# Generated from the source-of-truth service-account JSON / .streamlit/secrets.toml
GOOGLE_SERVICE_ACCOUNT_TYPE=service_account
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=<project-id>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=<key-id>
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=<sa@project.iam.gserviceaccount.com>
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=<client-id>
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SERVICE_ACCOUNT_CLIENT_X509_CERT_URL=<client-cert-url>
GOOGLE_SERVICE_ACCOUNT_UNIVERSE_DOMAIN=googleapis.com
# The private key MUST be the PEM block with literal newlines (or escaped \n).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----\n...>

# --- Spreadsheet keys ---
MASTER_SPREADSHEET_KEY=<production-master-key>   # NEVER written by tests
SANDBOX_SPREADSHEET_KEY=<sandbox-key>            # used by write/integration tests
# Registration (Form Pendaftaran) — SECOND spreadsheet, read-only command center.
# Single tab "Form Responses 1". Distinct from master; NOT declared in TAB_SCHEMAS.
REGISTRATION_SPREADSHEET_KEY=<registration-key>

# --- Phase C auth ---
# AUTH_SECRET: HMAC signing secret for the session cookie. >=16 chars.
# Generate a fresh one:  openssl rand -hex 32
AUTH_SECRET=<openssl rand -hex 32>
# AUTH_USERS: "username:password:role,user2:pass2:role2" (role optional, default viewer).
# ROTATE these before production.
AUTH_USERS=editor:<change-me-editor>:editor,viewer:<change-me-viewer>:viewer